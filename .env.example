# ============================================================
# SNAPIFY EDITOR - Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit your actual ".env" file to version control.
# ============================================================

# ---------------- Flask ----------------
FLASK_SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ---------------- Local storage paths ----------------
# Input videos MUST stay local (for speed) - this is the folder the app reads from & writes uploads into.
VIDEOS_FOLDER=app/videos
# Where rendered/exported clips are written before being pushed to Cloudinary
OUTPUTS_FOLDER=app/outputs
# Where lightweight preview proxies / thumbnails are cached
CACHE_FOLDER=app/cache

# ---------------- MongoDB ----------------
# Local mongod instance (per your setup)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=snapify_editor

# ---------------- Cloudinary ----------------
# Get these from https://console.cloudinary.com/console -> Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Base folder inside Cloudinary where exported reels are stored
CLOUDINARY_BASE_FOLDER=snapify-editor
CLOUDINARY_VIDEOS_SUBFOLDER=exported-videos

# ---------------- Ollama (ollama.com cloud) ----------------
# Ollama's cloud/turbo host. If you're running ollama locally instead,
# set this to http://localhost:11434
OLLAMA_HOST=https://ollama.com
# API key generated from https://ollama.com/settings/keys (needed for cloud host)
OLLAMA_API_KEY=your-ollama-api-key
# Lightweight, fast, good general-purpose model for captions/hashtags/titles.
# Swap to any model you have access to on your Ollama account.
OLLAMA_MODEL=gpt-oss:20b-cloud

# ---------------- YouTube Data API v3 (OAuth) ----------------
# From Google Cloud Console -> APIs & Services -> Credentials
# See SETUP_YOUTUBE.md for the full step-by-step walkthrough.
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_REDIRECT_URI=http://localhost:5000/youtube/oauth2callback

# ---------------- Scheduler ----------------
# How often (seconds) the background scheduler checks for due YouTube uploads
SCHEDULER_POLL_INTERVAL=60
